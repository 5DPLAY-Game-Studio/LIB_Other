<!--
  与 asconfig.json 保持同步。路径相对于此模块根目录。
  Flex/AIR/MX external：独立工程用 conf/sdk-external.xml；主工程子模块用
  ../tools/script/conf/sdk-external.xml（build.bat / 根目录 iml）。
-->
<flex-config>
	<!-- 编译器选项 -->
	<compiler>
		<!-- 构建调试版本 -->
		<debug>true</debug>
		
		<!-- 源代码路径，通常内容是和 include-sources 相同 -->
		<source-path>
			<path-element>src</path-element>
			
			<path-element>lib/Flash/src</path-element>
			<path-element>lib/ActionBSON/src</path-element>
			<path-element>lib/easy_lua/src</path-element>
			<path-element>lib/fzip/src</path-element>
			<path-element>lib/as3xls/src</path-element>
			<path-element>lib/tweener/src</path-element>
			<path-element>lib/ASZip/src</path-element>
			<path-element>lib/AIRZIP/src</path-element>
			<path-element>lib/GZIPEncoder/src</path-element>
			<path-element>lib/nochump-util-zip-optimized/src</path-element>
			<path-element>lib/as3wavsound/src</path-element>
			<path-element>lib/minimalcomps/src</path-element>
			<path-element>lib/starling/src</path-element>
		</source-path>
		
		<!-- 库文件的三种链接方式：Merged、External 和 Include -->
		<!-- Merged -->
		<library-path>
		</library-path>
		
		<!-- External -->
		<external-library-path append="true">
		</external-library-path>
		
		<!-- Include -->
		<include-libraries append="true">
			<library>swc</library>
		</include-libraries>
	</compiler>
	
	<!-- 包含路径，用于编译时即使没有引用到的路径下的库也进行导入 -->
	<include-sources>
		<path-element>src</path-element>
		
		<path-element>lib/Flash/src</path-element>
		<path-element>lib/ActionBSON/src</path-element>
		<path-element>lib/easy_lua/src</path-element>
		<path-element>lib/fzip/src</path-element>
		<path-element>lib/as3xls/src</path-element>
		<path-element>lib/tweener/src</path-element>
		<path-element>lib/ASZip/src</path-element>
		<path-element>lib/AIRZIP/src</path-element>
		<path-element>lib/GZIPEncoder/src</path-element>
		<path-element>lib/nochump-util-zip-optimized/src</path-element>
		<path-element>lib/as3wavsound/src</path-element>
		<path-element>lib/minimalcomps/src</path-element>
		<path-element>lib/starling/src</path-element>
	</include-sources>
	
	<!-- 包含类路径，用于编译时即使没有引用到的相关类也进行导入 -->
	<include-classes>
	</include-classes>
	
	<!-- 输出路径（默认使用 IDEA 的生成路径） -->
	<output>../out/production/LIB_Other/LIB_Other.swc</output>
</flex-config>
